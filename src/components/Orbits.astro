---
const { variant, class: klass } = Astro.props;
---

<svg viewBox="0 0 200 200" aria-hidden="true" class:list={['orbits', klass]}>
  {variant === 'hero' ? (
    <g fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="100" cy="100" r="86" />
      <ellipse cx="100" cy="100" rx="86" ry="30" />
      <ellipse cx="100" cy="100" rx="86" ry="60" />
      <ellipse cx="100" cy="100" rx="30" ry="86" />
      <ellipse cx="100" cy="100" rx="60" ry="86" />
      <line x1="14" y1="100" x2="186" y2="100" />
      <line x1="100" y1="14" x2="100" y2="186" />
    </g>
  ) : (
    <g fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="100" cy="100" r="86" />
      <ellipse cx="100" cy="100" rx="86" ry="34" />
      <ellipse cx="100" cy="100" rx="34" ry="86" />
      <ellipse cx="100" cy="100" rx="64" ry="86" />
      <line x1="14" y1="100" x2="186" y2="100" />
    </g>
  )}
</svg>
