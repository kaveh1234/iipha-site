---
import { copy, path } from '../i18n';
import '../styles/global.css';

const { lang, page } = Astro.props;
const t = copy[lang];
const pages = ['home', 'about', 'mission', 'join', 'donate'];
const suffix = page === 'home' ? '' : `/${page}`;
---

<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t[page].title}</title>
    <link rel="icon" href={path('/logo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Vazirmatn:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={path(`/${lang}`)}>
          <img src={path('/logo.png')} alt={t.logoAlt} width="40" height="40" />
          <span>{t.brand}</span>
        </a>
        <div class="header-end">
          <nav class="nav">
            {pages.map((p) => (
              <a href={path(`/${lang}${p === 'home' ? '' : `/${p}`}`)} aria-current={page === p ? 'page' : null}>
                {t.nav[p]}
              </a>
            ))}
          </nav>
          <div class="lang">
            <a class="en" href={path(`/en${suffix}`)} aria-current={lang === 'en' ? 'true' : null}>{t.langLabel.en}</a>
            <a class="fa" href={path(`/fa${suffix}`)} aria-current={lang === 'fa' ? 'true' : null}>{t.langLabel.fa}</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-brand">
          <div>{t.brand}</div>
          <div class="footer-name">{t.orgName}</div>
        </div>
        <div class="footer-meta">
          <a href={`mailto:${t.email}`}>{t.email}</a>
          {/* The year and Latin acronym must stay LTR inside the RTL footer. */}
          <span dir="ltr">{t.copyright}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
