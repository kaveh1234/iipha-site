---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { copy, langs } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = copy[lang].about;
---

<Layout lang={lang} page="about">
  <Hero claim={t.claim} orgName={copy[lang].orgName} lead={t.lead} />

  <section class="prose">
    <div class="wrap">
      {t.intro.map((p) => <p>{p}</p>)}

      <ol class="levels">
        {t.levels.map((l) => (
          <li>
            <strong>{l.label}</strong> — {l.body}
          </li>
        ))}
      </ol>

      <p>{t.outcomes}</p>
    </div>
  </section>

  <section class="contact">
    <div class="wrap">
      <div class="contact-label">{t.contactLabel}</div>
      <div class="contact-grid">
        {t.contact.map((c) => (
          <div>
            <div class="contact-item-label">{c.label}</div>
            {/* The US address stays LTR even on the Persian page. */}
            {c.href
              ? <a href={c.href} dir="ltr">{c.value}</a>
              : <p dir="ltr">{c.value}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="notes">
    <div class="wrap">
      <div class="notes-label">{t.notesLabel}</div>
      <ol>
        {t.notes.map((n) => (
          <li>
            <a href={n.url} dir="ltr">{n.text}</a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
