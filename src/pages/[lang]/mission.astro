---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { copy, langs } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = copy[lang].mission;
---

<Layout lang={lang} page="mission">
  <Hero claim={t.claim} lead={t.lead} />

  <section class="prose">
    <div class="wrap">
      {t.body.map((p) => <p>{p}</p>)}

      <h2 class="prose-heading">{t.chaptersLabel}</h2>
      <p>{t.chapters}</p>
      <p class="muted">{t.bylaws}</p>
    </div>
  </section>

  <section class="media">
    <div class="wrap">
      <a class="plain-link" href={t.videoUrl}>{t.videoLabel}</a>
    </div>
  </section>
</Layout>
